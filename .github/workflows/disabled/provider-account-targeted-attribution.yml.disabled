# Published only on a diagnostic branch at the registered qualification workflow path.
name: Provider account targeted attribution

on:
  workflow_dispatch:

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  history:
    if: startsWith(github.ref, 'refs/heads/diagnostic/provider-account-run2-')
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.4.2"
      - name: Probe three historical Git checkouts without builds
        env:
          GITHUB_SHA: ${{ github.sha }}
          QUALIFICATION_RUNNER_OS: ${{ runner.os }}
          QUALIFICATION_RUNNER_ARCH: ${{ runner.arch }}
        run: bun run script/kilocode/provider-account-qualification/history-targeted.ts "${{ runner.temp }}/history-targeted.json"
      - name: Publish safe checkout operations
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: provider-account-run2-targeted-history-${{ github.run_attempt }}
          path: ${{ runner.temp }}/history-targeted.json
          if-no-files-found: error

  windows:
    if: startsWith(github.ref, 'refs/heads/diagnostic/provider-account-run2-')
    runs-on: windows-2025
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: ./.github/actions/setup-bun
        with:
          install-flags: --ignore-scripts
      - name: Run only implicated Windows files
        env:
          GITHUB_SHA: ${{ github.sha }}
          QUALIFICATION_RUNNER_OS: ${{ runner.os }}
          QUALIFICATION_RUNNER_ARCH: ${{ runner.arch }}
        run: bun run script/kilocode/provider-account-qualification/targeted.ts windows "${{ runner.temp }}/targeted-windows.json"
      - name: Publish safe diagnostics
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: provider-account-run2-targeted-windows-${{ github.run_attempt }}
          path: ${{ runner.temp }}/targeted-windows.json
          if-no-files-found: error

  macos:
    if: startsWith(github.ref, 'refs/heads/diagnostic/provider-account-run2-')
    runs-on: macos-15
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "21"
      - uses: ./.github/actions/setup-bun
        with:
          install-flags: --ignore-scripts
      - name: Run focused boundaries and typecheck only
        env:
          GITHUB_SHA: ${{ github.sha }}
          QUALIFICATION_RUNNER_OS: ${{ runner.os }}
          QUALIFICATION_RUNNER_ARCH: ${{ runner.arch }}
          QUALIFICATION_JAVA: "true"
        run: bun run script/kilocode/provider-account-qualification/targeted.ts macos "${{ runner.temp }}/targeted-macos.json"
      - name: Publish safe diagnostics
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: provider-account-run2-targeted-macos-${{ github.run_attempt }}
          path: ${{ runner.temp }}/targeted-macos.json
          if-no-files-found: error
